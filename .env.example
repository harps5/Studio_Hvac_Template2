# Birchmont Studio HVAC template — environment variables
#
# Copy this file to .env.local for local dev, and set the same vars
# in the Vercel project dashboard for production.

# ---- Google Places API (optional) ----------------------------------------
# Enables live Google reviews via /lib/google-reviews.ts (Mode A).
# Leave blank to fall back to /config/site.ts manualReviews (Mode B).
# Create a key at https://console.cloud.google.com — enable "Places API (New)".
GOOGLE_PLACES_API_KEY=

# ---- Site origin (used in metadata, sitemap, JSON-LD) --------------------
NEXT_PUBLIC_SITE_URL=https://couleehvac.ca
